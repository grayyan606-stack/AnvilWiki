---
/**
 * Non-default-locale legal pages: /[locale]/about, /[locale]/privacy-policy, etc.
 * Copy uses the locale bundle with the normal English fallback.
 */
import LegalPage from '~/components/layout/LegalPage.astro';
import LegalContent from '~/components/layout/LegalContent.astro';
import { isLocale, defaultLocale, locales, type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';

export function getStaticPaths() {
  // Astro compiles getStaticPaths into its own module scope — external
  // top-level consts are NOT visible here. But module-level imports ARE.
  // `locales` comes from routing.ts, so it's safe to use here.
  const legalPages = ['about', 'privacy-policy', 'terms-of-service', 'copyright', 'contact'];
  const nonDefault = locales.filter((l) => l !== defaultLocale);
  return nonDefault.flatMap((locale) =>
    legalPages.map((page) => ({
      params: { locale, legal: page },
    })),
  );
}

const LEGAL_PAGES = ['about', 'privacy-policy', 'terms-of-service', 'copyright', 'contact'];
// Route params surface on Astro.params, NOT Astro.props (AGENTS.md gotcha #4).
const { locale: localeParam, legal } = Astro.params as { locale?: string; legal?: string };
if (!localeParam || !legal || !isLocale(localeParam) || localeParam === defaultLocale) {
  return new Response('Not Found', { status: 404 });
}
const locale: Locale = localeParam;

if (!LEGAL_PAGES.includes(legal)) {
  return new Response('Not Found', { status: 404 });
}
const pageKey = legal as 'about' | 'privacy-policy' | 'terms-of-service' | 'copyright' | 'contact';
const page = getUi(locale).legal.pages[pageKey];
---

<LegalPage locale={locale} title={page.title} description={page.description} lastUpdated={page.lastUpdated}>
  <LegalContent page={pageKey} locale={locale} />
</LegalPage>
