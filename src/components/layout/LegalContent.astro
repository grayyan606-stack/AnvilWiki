---
/** Legal-page copy is maintained in locale JSON, with English fallback. */
import { site } from '~/config/site';
import { defaultLocale, isLocale, type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { localizePath } from '~/lib/url';

interface Props {
  page: 'about' | 'privacy-policy' | 'terms-of-service' | 'copyright' | 'contact';
  locale?: Locale;
}
interface LegalSection {
  heading: string;
  paragraphs?: string[];
  items?: string[];
}
const { page, locale = isLocale(Astro.currentLocale ?? '') ? Astro.currentLocale as Locale : defaultLocale } = Astro.props;
const document = getUi(locale).legal.pages[page];
const sections: LegalSection[] = document.sections;
const values: Record<string, string> = {
  siteName: site.name,
  gameName: site.game.name,
  gameDeveloper: site.game.developer,
  officialUrl: site.social.official,
  year: String(new Date().getFullYear()),
};
const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({
  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
}[character] ?? character));

// Only repository-maintained JSON contains markup. Config substitutions are escaped;
// internal links follow the same locale routing as the rest of the site.
const renderCopy = (copy: string) => copy
  .replace(/\{(\w+)\}/g, (token, key: string) => key in values ? escapeHtml(values[key]) : token)
  .replace(/href="(\/(?!\/)[^"]*)"/g, (_match, path: string) => `href="${localizePath(path, locale)}"`);
---

{document.intro.map((paragraph) => <p set:html={renderCopy(paragraph)} />)}
{sections.map((section) => (
  <>
    <h2>{section.heading}</h2>
    {section.paragraphs?.map((paragraph) => <p set:html={renderCopy(paragraph)} />)}
    {section.items && <ul>{section.items.map((item) => <li set:html={renderCopy(item)} />)}</ul>}
  </>
))}
